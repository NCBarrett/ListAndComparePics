<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.RadioButton?>

<?import javafx.scene.text.Text?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.Region?>
<VBox fx:id="root" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.listandcomparepics.Controller">

    <HBox fx:id="dirPane" alignment="CENTER" spacing="10">
        <Button fx:id="dirBrowser" text="Directory Browser"
                onAction="#onDirBrowserClick"/>
        <Label fx:id="dirChosen"
                minWidth="200"/>
    </HBox>
<!-- style="-fx-border-color: black"    -->

    <HBox>
        <VBox fx:id="leftPane" alignment="CENTER" >
<!--             spacing="5.0"-->
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </padding>

            <VBox spacing="10" > <!--maxWidth="900" -->

                <TextField fx:id="RegEx" text="TEXT TO COPY: ^(?!Girl \d+(\s*\(\d+\))?).*"
                           maxWidth="250"/>
                <TextField fx:id="textRegEx" promptText="Enter RegEx" maxWidth="250"/>

                <HBox >
                    <!-- ListView will take remaining space and never get covered -->
                    <ListView fx:id="fileListView" maxWidth="400"/>

                    <!-- StackPane keeps the ImageView centered and clips overflow -->
                    <StackPane fx:id="imageContainer" prefWidth="500" prefHeight="300">
                        <!-- HBox.hgrow="ALWAYS"-->
                        <ImageView fx:id="imageViewer" fitWidth="500" fitHeight="300"
                                   preserveRatio="true"/>
<!--                         style="-fx-border-color: red"-->
                    </StackPane>
                </HBox>


            </VBox>
        </VBox>

        <HBox>

            <VBox fx:id="rightPane" alignment="TOP_RIGHT" spacing="10.0"
                    > <!--            style="-fx-border-color: black"-->

                <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </padding>
                    <TextField fx:id="RegEx2" text="TEXT TO COPY: ^Girl \d+(\s*\(\d+\))?" maxWidth="250"/>
                    <TextField fx:id="rtTextRegEx" promptText="Enter RegEx" maxWidth="250"/>

                    <HBox alignment="TOP_CENTER" >
    <!--                 style="-fx-border-color: red"   -->
                        <!-- ListView will take remaining space and never get covered -->
                        <VBox spacing="10">
                            <ListView fx:id="rtFileListView" prefHeight="400"/>
                            <!--                maxWidth="400"    -->

                        </VBox>

                    </HBox>
            </VBox>
        </HBox>
    </HBox>

    <VBox spacing="10" style="-fx-border-color: red">
        <HBox style="-fx-border-color: green">
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </padding>
            <VBox spacing="5">
                <HBox alignment="BASELINE_CENTER">
                    <Label text="Girl ID: "/>
                    <ComboBox fx:id="GirlID" editable="true" prefWidth="120"
                        promptText="Type/Select ID"/>
                </HBox>
                <HBox alignment="BASELINE_CENTER">
                    <Label text="Eye color: "/>
                    <ComboBox fx:id="EyeColor" editable="true" prefWidth="120"/>
                </HBox>
                <HBox alignment="BASELINE_CENTER">
                    <Label text="Hair color: "/>
                    <ComboBox fx:id="HairColor" editable="true" prefWidth="120"/>
                </HBox>
                <HBox alignment="BASELINE_CENTER">
                    <Label text="Bra size: "/>
                    <ComboBox fx:id="BraSize" editable="true" prefWidth="100"/>
                </HBox>
            </VBox>

            <Region prefWidth="20"/>

            <VBox  HBox.hgrow="ALWAYS" spacing="5" style="-fx-border-color: blue"
                >
<!--                -->
                <HBox style="-fx-border-color: orange" alignment="CENTER"
                        spacing="10">
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </padding>
                    <HBox alignment="BASELINE_CENTER" >
                        <Label text="Clothes Type: "/>
                        <ComboBox fx:id="ClothesType" editable="true"
                                  prefWidth="150"/>
                    </HBox>
                    <HBox alignment="BASELINE_CENTER" >
                        <Label text="Clothes Style: "/>
                        <ComboBox fx:id="ClothesStyle" editable="true"
                                  prefWidth="150"/>
                    </HBox>
                </HBox>
                <HBox>
                    <VBox style="-fx-border-color: purple" spacing="5">
                        <padding>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                        </padding>
                        <HBox spacing="10">
                            <Label text="Top/Only Pattern: "/>
                            <ComboBox fx:id="TopPattern" editable="true"
                                prefWidth="150"/>
                        </HBox>
                        <HBox>
                            <Label text="Main/Only Color: "/>
                            <ComboBox fx:id="MainOnlyColor" editable="true"
                                prefWidth="150"/>
                        </HBox>
                        <HBox>
                            <Label text="Color 2: "/>
                            <ComboBox fx:id="MainColor2" editable="true"
                                prefWidth="150"/>
                        </HBox>
                        <HBox>
                            <Label text="Color 3: "/>
                            <ComboBox fx:id="MainColor3" editable="true"
                                prefWidth="150"/>
                        </HBox>
                        <HBox>
                            <Label text="Color 4: "/>
                            <ComboBox fx:id="MainColor4" editable="true"
                                      prefWidth="150"/>
                        </HBox>
                        <HBox>
                            <Label text="Color 5: "/>
                            <ComboBox fx:id="MainColor5" editable="true"
                                    prefWidth="150"/>
                        </HBox>
                    </VBox>

                    <Region prefWidth="20"/>
                    <VBox style="-fx-border-color: indigo" spacing="5">

                        <padding>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                        </padding>
                        <HBox spacing="10">
                            <Label text="Bottom Pattern: "/>
                            <ComboBox fx:id="BottomPattern" editable="true"
                                prefWidth="150"/>
                        </HBox>
                        <HBox>
                            <Label text="Bottom Main/Only Color: "/>
                            <ComboBox fx:id="BottomOnlyColor" editable="true"
                                prefWidth="150"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <HBox alignment="CENTER" maxWidth="800"
              spacing="10" style="-fx-border-color: black">
            <!-- prefHeight="35"-->
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </padding>

            <TextField promptText="Select a file and add attributes." prefWidth="700"/>
            <Button fx:id="submitBtn" text="Submit" onAction="#submitButton"/>
        </HBox>
    </VBox>
</VBox>


